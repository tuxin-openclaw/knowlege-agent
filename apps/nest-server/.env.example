# S3-compatible object storage
# Tencent COS: https://cos.<REGION>.myqcloud.com
# AWS S3: leave endpoint empty to use the AWS default.
OBJECT_STORAGE_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
OBJECT_STORAGE_REGION=ap-guangzhou
OBJECT_STORAGE_BUCKET=tuxin-1302496097
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

PORT=3000

# 文本模型和生图模型都在页面“模型配置”中维护，不再使用环境变量。
# 这里只保留加密模型 API Key 的主密钥，至少 16 个字符，可用 `openssl rand -hex 32` 生成。
# 更换后已保存的模型 API Key 将无法解密，需要在页面重新填写。
MODEL_CONFIG_SECRET=

# 可选：模型配置缓存有效期（毫秒），默认 300000（5 分钟），设为 0 表示永不过期。
# 通过接口修改配置会立即清掉对应缓存，这个值只影响“绕过接口改库”“其他实例改库”的感知延迟。
# MODEL_CONFIG_CACHE_TTL_MS=300000

# PostgreSQL started by the repository Docker Compose
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/knowlege_agent
